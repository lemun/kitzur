{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kitzur": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Model via Kitzur",
      "options": {
        "baseURL": "http://127.0.0.1:8270/v1",
        "apiKey": "{env:GATEWAY_API_KEY}"
      },
      "models": {
        "REPLACE_WITH_GATEWAY_MODEL_ID": {
          "name": "Configured model",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 100000,
            "output": 32000
          }
        }
      }
    }
  },
  "model": "kitzur/REPLACE_WITH_GATEWAY_MODEL_ID",
  "small_model": "kitzur/REPLACE_WITH_GATEWAY_MODEL_ID",
  "compaction": {
    "auto": true,
    "prune": false
  }
}
