---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

// Replaces Starlight's built-in 404 (disable404Route in astro.config.mjs) so a dead link leads back into the docs.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const repo = 'https://github.com/lemun/kitzur';
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		description:
			'This Kitzur page does not exist. Start from the quick start, the troubleshooting guide or the repository on GitHub.',
		pagefind: false,
	}}
>
	<p>The page you asked for is not here. It may have moved when the docs were reorganized.</p>
	<ul>
		<li><a href={`${base}/docs/quick-start/`}>Quick start</a>: install Kitzur and point your agent at the proxy.</li>
		<li><a href={`${repo}/blob/main/docs/TROUBLESHOOTING.md`}>Troubleshooting</a>: common errors and what to check.</li>
		<li><a href={repo}>Repository on GitHub</a>: source, issues and releases.</li>
	</ul>
</StarlightPage>
